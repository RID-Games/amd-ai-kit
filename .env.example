# ============================================================================
# amd-ai-kit — machine configuration
# Copy to ./.env, edit, re-run ./install.sh. install.sh renders templates/
# with these values.
#
# NO SECRETS IN THIS FILE. API/HF tokens live in the secrets store
# (~/.config/amd-ai-kit/secrets.env, mode 600, created on first run).
# ============================================================================

# --- paths -------------------------------------------------------------------
# llama-swap binary (static Go). Get it: https://github.com/mostlygeek/llama-swap/releases
LLAMA_SWAP_BIN=/opt/amd-ai-kit/bin/llama-swap

# llama-server binary, built for your GPU(s) (see README "Building llama.cpp")
LLAMA_SERVER=/opt/amd-ai-kit/llama.cpp/build/bin/llama-server

# Directory holding .gguf model files
MODEL_DIR=/mnt/ai-fast/models

# Where rendered llama-swap configs go
CONFIG_DIR=/opt/amd-ai-kit/config

# systemd WorkingDirectory for the units
WORKDIR=/home/youruser

# Filesystem the models live on (unit gets RequiresMountsFor=; use / if none)
REQUIRES_MOUNT=/mnt/ai-data

# --- ROCm flavor ---------------------------------------------------------------
# TheRock (community ROCm/PyTorch) users: its lib dir, e.g. /mnt/ai-data/rocm-therock/lib
# System ROCm users: leave EMPTY — the rendered LD_LIBRARY_PATH= line is then a
# no-op (glibc treats an empty LD_LIBRARY_PATH as unset).
THEROCK_LIB=

# --- GPU selection ---------------------------------------------------------------
# HIP_VISIBLE_DEVICES values, one per card. Find them:  rocm-smi --showuniqueid
# Single-GPU box: leave EMPTY — llama-server then uses the only card.
# Why UUID and not index: binding a second GPU after boot renumbers HIP indexes
# and silently points a 20.9 GB model at the wrong (16 GB) card — OOM.
GPU_CHAT_UUID=
GPU_LLM_UUID=

# --- ports -----------------------------------------------------------------------
# llama-swap's own OpenAI-compatible API port, per instance (must differ per instance)
PORT_CHAT=11430      # 9060xt profile
PORT_LLM=11435       # v620 profile
PORT_CPU=11440       # cpu profile
# Internal llama-server port pools (must not overlap between instances)
STARTPORT_CHAT=5830
STARTPORT_LLM=5810
STARTPORT_CPU=5820

# --- models: 9060xt profile (16 GB RDNA4 card) ------------------------------------
GEMMA_GGUF=${MODEL_DIR}/gemma-4-12b-it-qat-q4_0.gguf
GEMMA_MMPROJ=${MODEL_DIR}/mmproj-gemma-4-12b-it-qat-q4_0.gguf
MINICPM_GGUF=${MODEL_DIR}/MiniCPM5-2B-Q8_0.gguf
QWEN8B_GGUF=${MODEL_DIR}/Qwen3-8B-Q4_K_M.gguf

# --- models: v620 profile (32 GB server card) --------------------------------------
QWEN27B_GGUF=${MODEL_DIR}/Qwen3.8-27B-UD-Q6_K.gguf

# --- models: cpu profile (GLM-5.3-Flash via colibri) --------------------------------
# colibri upstream: https://github.com/JustVugg/colibri (Apache-2.0)
COLI_BIN=/opt/amd-ai-kit/colibri/c/coli
GLM_MODEL_DIR=/mnt/ai-data/models/glm53_i4
VK_SHADERS_DIR=/opt/amd-ai-kit/colibri/c/shaders
# Pin Vulkan to the AMD driver: colibri's picker takes the first *discrete* device,
# and an NVIDIA ICD enumerating first will run your dense matmuls on a 246 MB
# host-visible window at CPU-slower speeds.
VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json
# Expert LRU cache pin (GB). Unset, colibri auto-sizes to (MemAvailable - 3 GB)
# and the kernel OOM-kills it. Pin small; disk streams the rest.
GLM53_EXPERT_GB=8
# systemd MemoryMax for the cpu unit — bounds GLM's footprint so a runaway dies
# in its cgroup instead of freezing the desktop.
GLM_MEMORY_MAX=22G
